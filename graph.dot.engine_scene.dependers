digraph "engine_scene" {
node [
  fontsize = "12"
];
    "node10" [ label = "engine_scene", shape = octagon ];
    "node2" [ label = "engine", shape = pentagon ];
    "node2" -> "node10" [ style = dashed ] // engine -> engine_scene
    "node12" [ label = "game", shape = egg ];
    "node12" -> "node2" [ style = dotted ] // game -> engine
}
