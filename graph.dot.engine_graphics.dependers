digraph "engine_graphics" {
node [
  fontsize = "12"
];
    "node6" [ label = "engine_graphics", shape = octagon ];
    "node2" [ label = "engine", shape = pentagon ];
    "node2" -> "node6" [ style = dashed ] // engine -> engine_graphics
    "node12" [ label = "game", shape = egg ];
    "node12" -> "node2" [ style = dotted ] // game -> engine
}
