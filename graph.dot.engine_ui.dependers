digraph "engine_ui" {
node [
  fontsize = "12"
];
    "node11" [ label = "engine_ui", shape = octagon ];
    "node2" [ label = "engine", shape = pentagon ];
    "node2" -> "node11" [ style = dashed ] // engine -> engine_ui
    "node12" [ label = "game", shape = egg ];
    "node12" -> "node2" [ style = dotted ] // game -> engine
}
