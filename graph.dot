digraph "portfolio" {
node [
  fontsize = "12"
];
subgraph clusterLegend {
  label = "Legend";
  color = black;
  edge [ style = invis ];
  legendNode0 [ label = "Executable", shape = egg ];
  legendNode1 [ label = "Static Library", shape = octagon ];
  legendNode2 [ label = "Shared Library", shape = doubleoctagon ];
  legendNode3 [ label = "Module Library", shape = tripleoctagon ];
  legendNode4 [ label = "Interface Library", shape = pentagon ];
  legendNode5 [ label = "Object Library", shape = hexagon ];
  legendNode6 [ label = "Unknown Library", shape = septagon ];
  legendNode7 [ label = "Custom Target", shape = box ];
  legendNode0 -> legendNode1 [ style = solid ];
  legendNode0 -> legendNode2 [ style = solid ];
  legendNode0 -> legendNode3;
  legendNode1 -> legendNode4 [ label = "Interface", style = dashed ];
  legendNode2 -> legendNode5 [ label = "Private", style = dotted ];
  legendNode3 -> legendNode6 [ style = solid ];
  legendNode0 -> legendNode7;
}
    "node0" [ label = "MySDL", shape = octagon ];
    "node1" [ label = "SDL2::SDL2", shape = doubleoctagon ];
    "node0" -> "node1"  // MySDL -> SDL2::SDL2
    "node2" [ label = "engine", shape = pentagon ];
    "node3" [ label = "engine_application", shape = octagon ];
    "node4" [ label = "engine_ecs", shape = octagon ];
    "node5" [ label = "external", shape = pentagon ];
    "node4" -> "node5"  // engine_ecs -> external
    "node3" -> "node4"  // engine_application -> engine_ecs
    "node2" -> "node3" [ style = dashed ] // engine -> engine_application
    "node2" -> "node4" [ style = dashed ] // engine -> engine_ecs
    "node6" [ label = "engine_graphics", shape = octagon ];
    "node2" -> "node6" [ style = dashed ] // engine -> engine_graphics
    "node7" [ label = "engine_map", shape = octagon ];
    "node8" [ label = "tinyxml2", shape = octagon ];
    "node7" -> "node8"  // engine_map -> tinyxml2
    "node2" -> "node7" [ style = dashed ] // engine -> engine_map
    "node9" [ label = "engine_resources", shape = octagon ];
    "node2" -> "node9" [ style = dashed ] // engine -> engine_resources
    "node10" [ label = "engine_scene", shape = octagon ];
    "node2" -> "node10" [ style = dashed ] // engine -> engine_scene
    "node11" [ label = "engine_ui", shape = octagon ];
    "node2" -> "node11" [ style = dashed ] // engine -> engine_ui
    "node12" [ label = "game", shape = egg ];
    "node12" -> "node2" [ style = dotted ] // game -> engine
}
